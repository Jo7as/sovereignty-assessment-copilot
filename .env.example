# Vorlage: nach .env kopieren und ein eigenes Passwort eintragen.
# Die .env wird nicht ins Repository übernommen.

POSTGRES_USER=copilot
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=sovereignty

# Muss zu den drei Werten oben passen
DATABASE_URL=postgresql+psycopg://copilot:bitte-aendern@localhost:5432/sovereignty

# KI für die Zuordnung über OpenRouter (optional). Ohne Schlüssel nur Textvergleich.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
